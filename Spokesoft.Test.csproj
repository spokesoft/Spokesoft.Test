<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.3</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Spokesoft</Company>
    <Authors>Spokesoft</Authors>
    <Description>Project management tool for the command line</Description>
    <PackAsTool>true</PackAsTool>
    <PackageId>Spokesoft.Test</PackageId>
    <PackageProjectUrl>https://github.com/spokesoft/Spokesoft.Test</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>tool cli dotnet agile scrum</PackageTags>
    <ToolCommandName>spokesoft</ToolCommandName>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/spokesoft/Spokesoft.Test.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>